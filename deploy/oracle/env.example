# ============================================================================
# Plantilla de variables de STAGING (Oracle + Vercel). NO contiene secretos.
# Copia a /opt/makingsmiles/.env (modo 600) o deja que bootstrap-oracle.sh la
# genere: el script rellena los valores marcados como GENERAR.
# NUNCA se commitea .env.
# ============================================================================

# --- Dominios y TLS ---------------------------------------------------------
DOMAIN=example.com
APP_DOMAIN=staging.example.com
API_DOMAIN=api.staging.example.com
ACME_EMAIL=ops@example.com
# CA de Let's Encrypt de producción. Para un primer ensayo (sin gastar cuota):
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# --- Imágenes ---------------------------------------------------------------
# La API se construye en CI y se publica en GHCR. En el servidor solo se hace pull.
API_IMAGE=ghcr.io/OWNER/makingsmiles-api:staging

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=makingsmiles
# GENERAR: openssl rand -hex 24
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=makingsmiles
# Se deriva de POSTGRES_PASSWORD; el bootstrap la reescribe.
EVOLUTION_DATABASE_URI=postgresql://makingsmiles:CAMBIAR@postgres:5432/evolution?schema=public

# --- API --------------------------------------------------------------------
# Workers de uvicorn. 2 es lo razonable en A1 (2 OCPU); 4 sobre-suscribe.
API_WORKERS=2
# Límites de Compose (se pueden subir si la instancia es mayor).
API_MEM_LIMIT=4g
API_CPUS=1.5
DATABASE_URL=postgresql+psycopg://makingsmiles:CAMBIAR@postgres:5432/makingsmiles
REDIS_URL=redis://redis:6379/0
# GENERAR: openssl rand -hex 48
SECRET_KEY=CAMBIAR
# GENERAR: openssl rand -hex 32 (mínimo 32 caracteres)
INTERNAL_API_KEY=CAMBIAR
ENVIRONMENT=staging
COOKIE_SECURE=1
# Informativo: compose la deriva de API_DOMAIN y se la pasa a la API. Si la
# cambias aquí sin cambiar API_DOMAIN no tendrá efecto (la de compose manda).
PUBLIC_API_URL=https://api.staging.example.com
TZ=Europe/Madrid

# --- Evolution API / WhatsApp ----------------------------------------------
# GENERAR: openssl rand -hex 24
EVOLUTION_API_KEY=CAMBIAR
EVOLUTION_API_URL=http://evolution:8080

# --- Integraciones opcionales (vacías = pila arranca y /health/db responde) --
LLM_BASE_URL=
LLM_MODEL=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY_FREE=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OCR_API_KEY=
TXT_API_KEY=

# --- Copias de seguridad (las usa backup-postgres.sh, servicio systemd root) --
BACKUP_DIR=/opt/makingsmiles/backups
BACKUP_RETENTION_DAYS=14
# Destino FUERA del host. Debe ser un DIRECTORIO DEDICADO: el rsync usa
# --delete para espejar la retención (todo lo que no esté en la copia local se
# borra en el remoto). p. ej. usuario@host:/srv/backups/makingsmiles-staging
BACKUP_DEST=
# Clave SSH y known_hosts FIJADOS (no accept-new): ambos legibles por root (600).
BACKUP_SSH_KEY=/opt/makingsmiles/.ssh/backup_key
BACKUP_KNOWN_HOSTS=/opt/makingsmiles/.ssh/known_hosts
# Cifrado en reposo ANTES de salir del host (age). Obligatorio si offsite=1.
# Genera el par con: age-keygen -o /opt/makingsmiles/.ssh/age.key
# y pon aquí la clave PÚBLICA: age1...
BACKUP_AGE_RECIPIENT=
BACKUP_OFFSITE_REQUIRED=1
# 1 = incluir también media (radiografías/documentos). Si está a 1 y falla el
# tar, la copia es FALLO (no se ignora).
BACKUP_MEDIA=1
